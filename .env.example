# Copia este archivo como .env (NUNCA lo subas a GitHub ni lo pongas en la carpeta public)

# IA (obligatoria para el asesor con IA). Créala en https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modelo: claude-haiku-5-5 es el más económico; claude-sonnet-5-5 razona mejor pero cuesta más
ANTHROPIC_MODEL=claude-haiku-5-5

# Clave del panel de fotos (/admin). Mínimo 16 caracteres, inventa una larga y aleatoria.
ADMIN_TOKEN=

# Opcional: dictado por voz en navegadores que no lo traen (Firefox). https://platform.openai.com
OPENAI_API_KEY=

# Control de abuso y costos
RATE_PER_10MIN=20
DAILY_AI_LIMIT=1500
MAX_OUTPUT_TOKENS=700

# Pon 1 si el servidor está detrás de un proxy (Render, Railway, Nginx) para que el límite por usuario use la IP real
TRUST_PROXY=1
PORT=3000
# Solo si la página está en otro dominio distinto al servidor, ej: https://www.ltdelllano.com
ALLOWED_ORIGINS=
